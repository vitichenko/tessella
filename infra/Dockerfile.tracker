# Construction Phase
FROM rust:1.81-slim as builder

WORKDIR /usr/src/tessella
COPY . .

# Install dependencies for compilation
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

# Build the tracker
RUN cargo build --release --package tessella-tracker

# Execution Phase
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y libssl3 ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /usr/src/tessella/target/release/tessella-tracker /app/tessella-tracker
RUN mkdir -p /app/config

# Ports (API: 8000, P2P: 9000 depending on your firewall)
EXPOSE 8000
EXPOSE 9000

ENTRYPOINT ["/app/tessella-tracker"]
CMD ["--config", "/app/config/tracker.toml", "--headless"]
